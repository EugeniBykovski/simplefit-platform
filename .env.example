# SimpleFit Platform environment variables.
#
# Copy to .env.local for local development (.env.local is git-ignored):
#   cp .env.example .env.local
#
# RULES
# * NEXT_PUBLIC_* variables are inlined into the browser JavaScript bundle at
#   BUILD time and are readable by every visitor. Only values that are safe to
#   publish belong here (public URLs, public feature flags).
# * Server-only variables (API keys, tokens, signing secrets) must NEVER use
#   the NEXT_PUBLIC_ prefix. Read them only from server-only modules (Server
#   Components, Route Handlers, Server Actions) and set them in the deployment
#   environment, never in Git.
# * Document every new variable in this file with a safe placeholder value.

# ---------------------------------------------------------------------------
# Public (exposed to the browser)
# ---------------------------------------------------------------------------

# Base URL of the SimpleFit API (Phoenix backend), no trailing slash.
# The local default matches `mix phx.server` in simplefit-api.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Google OAuth *Web application* client ID for "Continue with Google" (SF-22).
# A client ID is public (it is in every page that shows the button); the client
# secret is never used by SimpleFit and must not be added anywhere.
# In Google Cloud Console add every web origin (e.g. http://localhost:3000 and
# http://localhost for local development) to "Authorized JavaScript origins".
# The same ID must be listed in the API's GOOGLE_OAUTH_CLIENT_IDS.
# Optional: when unset, Google sign-in shows as unavailable.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Sign in with Apple (SF-23): the web Services ID and the HTTPS Return URL
# registered for it in Apple Developer (Services ID > Configure). Apple JS runs
# in popup mode, so nothing is served at that URL by this app, but it must
# match exactly, use https and sit on a registered domain: Apple never accepts
# localhost or IP addresses. Both are public identifiers; no Apple private key
# is used. Optional: without both, Apple sign-in shows as unavailable.
# The Services ID must also be listed in the API's APPLE_SIGN_IN_CLIENT_IDS.
NEXT_PUBLIC_APPLE_SERVICES_ID=
NEXT_PUBLIC_APPLE_REDIRECT_URI=

# ---------------------------------------------------------------------------
# Server-only (never prefixed with NEXT_PUBLIC_)
# ---------------------------------------------------------------------------
# None yet.
