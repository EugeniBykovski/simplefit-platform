# SimpleFit Platform environment variables.
#
# Copy to .env.local for local development (.env.local is git-ignored):
#   cp .env.example .env.local
#
# RULES
# * NEXT_PUBLIC_* variables are inlined into the browser JavaScript bundle at
#   BUILD time and are readable by every visitor. Only values that are safe to
#   publish belong here (public URLs, public feature flags).
# * Server-only variables (API keys, tokens, signing secrets) must NEVER use
#   the NEXT_PUBLIC_ prefix. Read them only from server-only modules (Server
#   Components, Route Handlers, Server Actions) and set them in the deployment
#   environment, never in Git.
# * Document every new variable in this file with a safe placeholder value.

# ---------------------------------------------------------------------------
# Public (exposed to the browser)
# ---------------------------------------------------------------------------

# Base URL of the SimpleFit API (Phoenix backend), no trailing slash.
# The local default matches `mix phx.server` in simplefit-api.
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# Server-only (never prefixed with NEXT_PUBLIC_)
# ---------------------------------------------------------------------------
# None yet.
